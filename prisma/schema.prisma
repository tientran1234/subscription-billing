generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  /// The ceiling this workspace set on its metered add-on, in units past the
  /// plan's quota. Null means uncapped, which is what every workspace from
  /// before caps existed carries: a cap nobody set is not a cap of zero.
  ///
  /// On the tenant rather than the subscription, because the subscription's
  /// columns mirror what the gateway sold and move on its webhooks, while a cap
  /// is ours alone — the gateway is never told it — and outlives a workspace
  /// that cancels and subscribes again, exactly as its usage counters do.
  overageCap    Int?
  /// The language this workspace is written to in, as one of the locales in
  /// src/i18n.ts, or null for a workspace that has never said. Null is not
  /// English: it is the absence of an answer, which is what every tenant from
  /// before this column carries — src/domain/notice-locale.ts holds the rule
  /// that turns it into a language to send in.
  ///
  /// On the tenant for the same reason the cap is. A notice is addressed to the
  /// workspace, and the locale a page happened to render in belongs to one
  /// reader's browser on one afternoon — not to the workspace a webhook writes
  /// to hours later, from a request with no reader and no URL to read it off.
  locale        String?
  subscriptions Subscription[]
  usage         UsageCounter[]
  apiKeys       ApiKey[]
  members       Membership[]
  invitations   Invitation[]
  dunning       DunningNotice[]
  capNotices    CapNotice[]
  replays       EventReplay[]
  roleGrants    RoleGrant[]
  createdAt     DateTime        @default(now())
}

/// A signed-in person. Auth.js owns these rows; nothing here is billed.
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  createdAt     DateTime     @default(now())
}

/// Which tenants a user may act for. The join is the ownership check: routes
/// resolve a tenant out of these rows and never out of the request body.
model Membership {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// What this person may do in the workspace, as one of the roles in
  /// src/domain/role.ts: an admin may change it, a member may read it.
  ///
  /// The default is `admin` for one reason only — every row that predates this
  /// column belongs to somebody who could already do everything, and a default
  /// of `member` would take that away from people who are using it. Every
  /// write here states the role instead of relying on it, so the day the last
  /// of those rows is gone the default is doing nothing. It is read back
  /// through `roleFrom`, which narrows an unrecognised value to `member`.
  role      String   @default("admin")
  createdAt DateTime @default(now())

  @@id([userId, tenantId])
  @@index([tenantId])
}

/// An offer of a seat to an address that does not hold one yet.
///
/// Addressed rather than bearer: there is no token in this row and none in the
/// mail. Sign-in here is a magic link, so the mailbox is already the
/// credential, and a token would be a second and weaker one for the same thing
/// — forwardable to somebody the workspace never invited. The invited address
/// signs in the way everybody else does, and an open row in its name is what
/// turns that sign-in into a membership. See src/domain/invite.ts.
model Invitation {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The address invited, lower-cased: it is matched against the address that
  /// signs in, and nobody types their own the same way twice.
  email           String
  /// Who sent it, as plain columns rather than a relation to User — the row
  /// has to outlive the account that sent it, and the address is recorded as
  /// it was at the time, the way DunningNotice records the one it wrote to.
  invitedByUserId String
  invitedByEmail  String
  /// The role the membership will be made with, chosen when the seat is
  /// offered. On the invite rather than settled afterwards so that what is
  /// being offered is what arrives: an address accepting a seat should not
  /// land with powers nobody decided to give it.
  ///
  /// Unlike the membership default this one is `member`, which is the right
  /// way round for a row nobody has to have filled in: an invite sent before
  /// this column existed grants the least it can, and the workspace can
  /// promote whoever accepts it.
  role            String    @default("member")
  /// When the seat this invite is holding comes back. An invite past this is
  /// closed with nothing having to run: the roster simply stops counting it.
  expiresAt       DateTime
  /// Set once, when the address signs in and the membership is made. The
  /// affected-row count on that update is the claim, so two sign-ins racing
  /// produce one membership and one no-op.
  acceptedAt      DateTime?
  acceptedByUserId String?
  /// Withdrawn by the workspace. Kept apart from acceptance so a seat that
  /// came back can be told from one that was taken.
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([email])
}

/// Auth.js: a linked external identity. Unused by magic links, but the Prisma
/// adapter reads and writes it, so the model has to exist.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

/// Auth.js: server-side sessions. Sessions live in Postgres rather than in a
/// JWT so that revoking access takes effect on the next request, the same way
/// a revoked API key does.
model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js: the single-use magic-link token emailed to the address signing in.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// One row per subscription attempt. `status` only ever moves forward through
/// the transitions declared in src/domain/subscription.ts.
model Subscription {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planKey          String
  status           String
  provider         String        @default("stripe")
  /// Provider's subscription id. Arrives on the first webhook, not at checkout.
  providerRef      String?       @unique
  /// Provider's checkout session id. Known immediately, so webhooks that carry
  /// only the session can still find this row.
  checkoutRef      String?       @unique
  /// Provider's customer id, learned from the first webhook. Not unique: a
  /// tenant that cancels and subscribes again keeps the same customer across
  /// both rows. This is what the billing portal opens for.
  customerRef      String?
  /// Seats paid for — the `quantity` on the provider's price. Moves on the paid
  /// invoice that bills for it, exactly as `planKey` does.
  seats            Int           @default(1)
  /// Whether this subscription was bought with the metered add-on — a second,
  /// metered item beside the plan's own, which usage past the quota is reported
  /// against. Recorded because it is part of what was bought, and because a
  /// subscription opened before the add-on was sold has no meter to report to.
  meteredOverage   Boolean       @default(false)
  /// Currency this subscription is billed in, chosen at checkout. Unlike the
  /// plan and the seats it never moves: the provider fixes a subscription's
  /// currency when it creates it and will not reprice a live one into another,
  /// so a customer changing their mind subscribes again rather than updates.
  currency         String        @default("usd")
  currentPeriodEnd DateTime?
  usageReports     UsageReport[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId, status])
}

/// One row per month of overage reported to the provider. The (subscription,
/// period) pair is the primary key, so a job that runs twice — on a schedule
/// and by hand, or after a crash — loses the insert instead of billing the same
/// month again. A row here means the provider was told: a report it refuses
/// releases its claim rather than leave one behind, the way a dunning notice
/// does.
model UsageReport {
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// The UTC month the figure was counted over, as `meter` buckets usage.
  period         String
  /// Units past the quota, which is what was billed — not the raw counter.
  quantity       Int
  reportedAt     DateTime     @default(now())

  @@id([subscriptionId, period])
}

/// Idempotency gate. The provider's event id is the primary key, so a duplicate
/// delivery fails the insert instead of being processed twice.
model WebhookEvent {
  providerEventId String   @id
  provider        String
  type            String
  subscriptionId  String?
  receivedAt      DateTime @default(now())
}

/// One row per dunning email that has gone out. Keyed by the provider's event
/// id, so a second delivery of the same event loses the insert instead of
/// mailing the customer twice. A row here means an email was sent: a send that
/// fails releases its claim rather than leave one behind.
model DunningNotice {
  providerEventId String   @id
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind            String
  /// The address it went to, as it was at the time.
  to              String
  sentAt          DateTime @default(now())

  @@index([tenantId])
}

/// One row per cap warning that has gone out: at most one of each kind per
/// workspace per month. Keyed by (tenant, period, kind) rather than by a
/// provider event id — what earns this mail is a counter of ours crossing a
/// line rather than a delivery from the gateway, and the month is the only
/// thing that can make "we have already said this" true. A row here means a
/// mail was sent: a send that fails releases its claim rather than leave one
/// behind, the way a dunning notice does.
model CapNotice {
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The UTC month the usage was counted in, as `meter` buckets it.
  period   String
  /// Which line was crossed: approaching the ceiling, or refused at it.
  kind     String
  /// Units past the quota when it was sent, and the ceiling they were measured
  /// against. Both as they were at the time — a cap the workspace raises
  /// afterwards does not make what was written to them wrong.
  units    Int
  cap      Int
  /// The address it went to, as it was at the time.
  to       String
  sentAt   DateTime @default(now())

  @@id([tenantId, period, kind])
}

/// One row per replay attempt: who asked for which provider event to be
/// re-applied, and what came of it. Deliberately not keyed by the event id —
/// the same event may be replayed more than once, and an audit that kept only
/// the first attempt would hide every one after it.
model EventReplay {
  id              String   @id @default(cuid())
  /// The id as it was asked for, which is not promised to be an event that
  /// exists: a refused attempt is the kind an audit is read for.
  providerEventId String
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Who asked, held as plain columns rather than a relation to User: an audit
  /// row has to outlive the account it names, and the address is recorded as it
  /// was at the time, the way DunningNotice records the one it wrote to.
  userId          String
  userEmail       String
  /// What came of it — an applyEvent outcome, or the reason it was refused.
  /// Null means an attempt that never reported back, which is precisely the
  /// row worth finding: it is written before the work, so a replay that dies
  /// halfway is still attributable.
  outcome         String?
  requestedAt     DateTime @default(now())

  @@index([tenantId, requestedAt])
}

/// One role this workspace handed out: whom to, by whom, and when.
///
/// Append-only, and deliberately not keyed by the membership it describes. A
/// role is a column that overwrites the one before, so this table is the only
/// place the sequence of those writes survives — and a membership that is
/// removed leaves its grants behind, because what the workspace wants to be
/// able to say about somebody who was once an admin does not stop being true
/// the day they leave.
model RoleGrant {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Who holds the role, and who gave it to them, as plain columns rather than
  /// relations to User: an audit row has to outlive the accounts it names, and
  /// each address is recorded as it was at the time — the way EventReplay
  /// records the one that asked for a replay.
  subjectUserId   String
  subjectEmail    String
  grantedByUserId String
  grantedByEmail  String
  /// The role granted, as one of the roles in src/domain/role.ts, read back
  /// through `roleFrom` like every other copy of one.
  ///
  /// There is no column for the role it replaced. A write that granted the
  /// role somebody already held is not recorded at all, so a row here always
  /// means the role became this one — which is what makes the date on it the
  /// date they became it rather than the date it was last confirmed.
  role            String
  grantedAt       DateTime @default(now())

  @@index([tenantId, grantedAt])
}

/// Metered usage per tenant, per feature, per UTC month.
model UsageCounter {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature  String
  period   String
  used     Int    @default(0)

  @@id([tenantId, feature, period])
}

/// A machine credential for a tenant. Only the hash is stored; the raw key is
/// returned once at creation and cannot be recovered.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyHash    String    @unique
  /// Display-only, e.g. "sk_live_3f9a1c" — enough to recognise a key in a list.
  prefix     String
  scopes     String[]
  /// Requests per UTC month. Null means unmetered.
  quotaLimit Int?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}
