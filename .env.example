# Postgres — `pnpm db:up` starts one on this URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/billing?schema=public"

# Stripe (test mode). Webhook secret comes from `pnpm stripe:listen`.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Where Stripe sends the customer back after checkout
APP_URL="http://localhost:3000"

# Auth.js — `openssl rand -base64 32` for the secret. EMAIL_SERVER is any SMTP
# url, used for magic links and for dunning notices; a local catcher such as
# Mailpit is enough to click a link and read a past-due mail in dev.
AUTH_SECRET="..."
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="billing@example.test"
